{
 "dialogos": [
  {
   "id": "dlg_tuya_nomarca",
   "npc": "tuya_nomarca",
   "inicio": "raiz",
   "nos": {
    "raiz": {
     "fala": "A rua de cima é nossa. A de baixo é dos avós. Prática e cobradora.",
     "opcoes": [
      {
       "texto": "A Terra Negra?",
       "ir": "eg_k01_oferta",
       "se": {
        "missao_disponivel": "eg_k01"
       }
      },
      {
       "texto": "Sobre a terra negra.",
       "ir": "eg_k01_fim",
       "se": {
        "missao_pronta": "eg_k01"
       }
      },
      {
       "texto": "O Dízimo da Nomarca?",
       "ir": "eg_k02_oferta",
       "se": {
        "missao_disponivel": "eg_k02"
       }
      },
      {
       "texto": "Sobre o dízimo da nomarca.",
       "ir": "eg_k02_fim",
       "se": {
        "missao_pronta": "eg_k02"
       }
      },
      {
       "texto": "Os Campos que Voltaram?",
       "ir": "eg_k04_oferta",
       "se": {
        "missao_disponivel": "eg_k04"
       }
      },
      {
       "texto": "Sobre os campos que voltaram.",
       "ir": "eg_k04_fim",
       "se": {
        "missao_pronta": "eg_k04"
       }
      },
      {
       "texto": "A Avenida de Amon?",
       "ir": "eg_k09_oferta",
       "se": {
        "missao_disponivel": "eg_k09"
       }
      },
      {
       "texto": "Sobre a avenida de amon.",
       "ir": "eg_k09_fim",
       "se": {
        "missao_pronta": "eg_k09"
       }
      },
      {
       "texto": "Turno em Karnak?",
       "ir": "eg_r03_oferta",
       "se": {
        "missao_disponivel": "eg_r03"
       }
      },
      {
       "texto": "Sobre turno em karnak.",
       "ir": "eg_r03_fim",
       "se": {
        "missao_pronta": "eg_r03"
       }
      },
      {
       "texto": "Quem é você?",
       "ir": "historia"
      },
      {
       "texto": "Até mais."
      }
     ]
    },
    "eg_k01_oferta": {
     "fala": "Chegou pela Linha 7? Então chegou com fome e sem saber onde pisa. O Nilo voltou, forasteiro. Desça o nilômetro e veja até onde. Depois procure Ahmose nas docas.",
     "opcoes": [
      {
       "texto": "Deixa comigo.",
       "acoes": [
        {
         "aceitar_missao": "eg_k01"
        }
       ]
      },
      {
       "texto": "Agora não."
      }
     ]
    },
    "eg_k01_fim": {
     "fala": "Viu a marca? Dois degraus acima dos avós. Bem-vindo à Terra Negra.",
     "opcoes": [
      {
       "texto": "Feito.",
       "acoes": [
        {
         "concluir_missao": "eg_k01"
        }
       ]
      }
     ]
    },
    "eg_k02_oferta": {
     "fala": "Tem gente cavando nos meus campos sem selo. E tem crocodilo deitado no meu linho. Resolva os dois.",
     "opcoes": [
      {
       "texto": "Deixa comigo.",
       "acoes": [
        {
         "aceitar_missao": "eg_k02"
        }
       ]
      },
      {
       "texto": "Agora não."
      }
     ]
    },
    "eg_k02_fim": {
     "fala": "Três selos. Oito crocodilos. Você sabe contar, gosto disso.",
     "opcoes": [
      {
       "texto": "Feito.",
       "acoes": [
        {
         "concluir_missao": "eg_k02"
        }
       ]
      }
     ]
    },
    "eg_k04_oferta": {
     "fala": "Khepri rola o sol, eles dizem. Esses aí estão rolando a minha lavoura.",
     "opcoes": [
      {
       "texto": "Deixa comigo.",
       "acoes": [
        {
         "aceitar_missao": "eg_k04"
        }
       ]
      },
      {
       "texto": "Agora não."
      }
     ]
    },
    "eg_k04_fim": {
     "fala": "Dez escaravelhos. Os velhos vão rezar por eles. Eu vou plantar.",
     "opcoes": [
      {
       "texto": "Feito.",
       "acoes": [
        {
         "concluir_missao": "eg_k04"
        }
       ]
      }
     ]
    },
    "eg_k09_oferta": {
     "fala": "Eu preciso da estrada para Karnak. As esfinges acham que ela é delas.",
     "opcoes": [
      {
       "texto": "Deixa comigo.",
       "acoes": [
        {
         "aceitar_missao": "eg_k09"
        }
       ]
      },
      {
       "texto": "Agora não."
      }
     ]
    },
    "eg_k09_fim": {
     "fala": "A estrada é minha de novo. As esfinges vão se acostumar.",
     "opcoes": [
      {
       "texto": "Feito.",
       "acoes": [
        {
         "concluir_missao": "eg_k09"
        }
       ]
      }
     ]
    },
    "eg_r03_oferta": {
     "fala": "O salão hipostilo tem guarda nova. Morta. Tire.",
     "opcoes": [
      {
       "texto": "Deixa comigo.",
       "acoes": [
        {
         "aceitar_missao": "eg_r03"
        }
       ]
      },
      {
       "texto": "Agora não."
      }
     ]
    },
    "eg_r03_fim": {
     "fala": "Diária feita. Volte amanhã.",
     "opcoes": [
      {
       "texto": "Feito.",
       "acoes": [
        {
         "concluir_missao": "eg_r03"
        }
       ]
      }
     ]
    },
    "historia": {
     "fala": "A avó dela morava em Mit Rahina, em cima das ruínas de Mênfis. Quando o Nilo voltou e baixou, Tuya foi a primeira a cavar a casa da avó com as mãos e achou embaixo a casa de alguém de três mil anos atrás. Hoje toda Mênfis mora em dois andares: o de lama é de agora, o de pedra é de antes. Ela cobra dízimo de todo mundo que cava no planalto, porque 'a terra é preta e a terra é minha'.",
     "opcoes": [
      {
       "texto": "Voltar.",
       "ir": "raiz"
      }
     ]
    }
   }
  },
  {
   "id": "dlg_hapu_mercador",
   "npc": "hapu_mercador",
   "inicio": "raiz",
   "nos": {
    "raiz": {
     "fala": "Escaravelho de verdade! Bom, quase. Simpático demais.",
     "opcoes": [
      {
       "texto": "Quero ver o que você tem.",
       "acoes": [
        {
         "abrir_loja": "loja_hapu"
        }
       ]
      },
      {
       "texto": "Quem é você?",
       "ir": "historia"
      },
      {
       "texto": "Até mais."
      }
     ]
    },
    "historia": {
     "fala": "Comprava e vendia antiguidade falsa para turista antes do Juízo. Agora vende antiguidade verdadeira para quem quiser e pão para quem precisa, e diz que o lucro é o mesmo.",
     "opcoes": [
      {
       "texto": "Voltar.",
       "ir": "raiz"
      }
     ]
    }
   }
  },
  {
