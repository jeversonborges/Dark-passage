       "texto": "Feito.",
       "acoes": [
        {
         "concluir_missao": "eg_k03"
        }
       ]
      }
     ]
    },
    "eg_r01_oferta": {
     "fala": "Juncal cheio de novo. Limpa um pouco, que eu levo água para quem fica.",
