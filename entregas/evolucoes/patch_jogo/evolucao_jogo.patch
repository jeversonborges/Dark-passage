+	if absf(j2.hp_max - j.hp_max) > 0.5: falha(tag + ": hp_max depois do save %.1f != %.1f" % [j2.hp_max, j.hp_max])
+	if absf(j2.defesa - j.defesa) > 0.01: falha(tag + ": defesa depois do save %.2f != %.2f" % [j2.defesa, j.defesa])
