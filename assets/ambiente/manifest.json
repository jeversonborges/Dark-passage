  "pasta": "tiles/bordas/",
  "nome": "<piso>_<lado>.png, atlas 4x4 igual ao piso",
  "lados": {
   "x+": "cobre o lado +X do tile (baixo-direita) e some para dentro",
   "x-": "lado -X",
   "y+": "lado +Y (cima-direita)",
   "y-": "lado -Y",
   "xy++": "so o canto +X+Y",
   "xy+-": "canto +X-Y",
   "xy-+": "canto -X+Y",
   "xy--": "canto -X-Y"
  },
  "uso": "desenhe por cima do tile B o <pisoA>_<lado> do lado em que o vizinho e o piso A; mesma celula (x mod 4, y mod 4)"
 }
