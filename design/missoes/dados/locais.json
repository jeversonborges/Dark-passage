  "dungeons": [
    {
      "id": "cripta_trombeta",
      "nome": "Cripta da Trombeta Calada",
      "nivel": [
        6,
        12
      ],
      "entrada": {
        "subzona": "abatedouro_carnica",
        "ponto": "porta_ganchos",
        "requer_item": "chave_gancho"
      },
      "descricao": "Por baixo do frigorífico enterrado fica a Vala da Grande Batalha, onde Benedito jogou os mortos dos Campos de Cinza. Mais fundo, abaixo até de onde a areia chega, as catacumbas da paróquia, e por baixo delas uma catedral mais velha que a cidade, onde a quinta trombeta espera com um lacre de chumbo no bocal. Aqui embaixo não cai Amargo: é o lugar mais limpo da região, e o mais perigoso.",
      "andares": [
        {
          "id": "porao_matadouro",
          "numero": 1,
          "nome": "Porão do Matadouro",
          "descricao": "Câmaras frias, trilhos de ganchos que ainda giram, caldeiras pingando gordura. No fundo, o fosso onde os mortos da Grande Batalha foram jogados, e quem ainda come lá.",
          "monstros": [
            "acougueiro_oco",
            "larva_de_carne",
            "gancheiro",
            "soldado_caido"
          ],
          "chefe": "general_partido",
          "ambiente": "vapor, luz vermelha das caldeiras, chão grudento; no fosso, ossos e armaduras dos dois lados até onde a luz alcança",
          "nivel": [
            6,
            8
          ]
        },
        {
          "id": "ossario_carpideiras",
          "numero": 2,
          "nome": "Ossário das Carpideiras",
          "descricao": "Catacumbas medievais com paredes de crânios. Celas onde monges foram emparedados vivos por penitência. De longe se ouve um coro.",
          "monstros": [
            "monge_emparedado",
            "carpideira_de_ossos",
            "fogo_de_vela"
          ],
          "chefe": "irma_celeste",
          "ambiente": "milhares de velas derretidas, eco de canto, poeira de osso",
          "nivel": [
            8,
            10
          ]
        },
        {
          "id": "camara_trombeta",
          "numero": 3,
          "nome": "Câmara da Trombeta",
          "descricao": "Uma catedral subterrânea de pedra negra. Correntes descem do teto até o altar, onde um anjo acorrentado segura a quinta trombeta lacrada.",
          "monstros": [
            "querubim_desfeito",
            "eco_da_trombeta"
          ],
          "chefe": "zacarias_arauto",
          "ambiente": "vitral sem sol aceso por dentro, zumbido grave constante, poeira dourada",
          "nivel": [
            10,
            12
          ]
        }
      ]
    },
