{
 "_doc": "XP e niveis. Responde o ponto em aberto 2 de classes.md: nivel maximo 400 (evolucoes no 150 e no 400, estilo MU). A primeira entrega cobre do 1 ao ~13.",
 "versao": "0.2",
 "nivel_maximo": 400,
 "formula_xp_para_proximo": "75*L^2 + 375*L (v0.2: 3x a v0.1, porque os spots com leque e modo automatico matam 20 a 30 monstros por minuto); acima do 100 multiplica por (1 + (L-100)/50). Arredondado.",
 "metas_de_ritmo": {
  "_doc": "v0.2, com spots e modo automatico (farm_auto.json). Conferido por farm.py.",
  "spot_nivel_5_a_10": "cerca de 4 a 9 min por nivel farmando no spot do proprio nivel com pocoes",
  "area_inicial": "nivel 1 ao 7 em 50 a 70 min (missoes + spots)",
  "cripta": "nivel 7 ao 12-13 em cerca de 2 h (cripta + spots + deserto)",
  "parte_da_xp_vinda_de_missoes": 0.3
 },
 "xp_mob": {
  "formula": "(10 + 5*L_mob) * mult_arquetipo",
  "chefe": "(10 + 5*L) * 25 na primeira vitoria do dia; 8 nas seguintes",
  "modificador_diferenca_nivel": {
   "_doc": "d = nivel_mob - nivel_jogador",
   "d_maior_igual_5": 1.2,
   "d_entre_menos3_e_4": "1 + 0.04*d",
   "d_menor_igual_menos4": "max(0.10, 1 - 0.15*(-d - 3) - 0.12)"
  }
 },
 "xp_missao_referencia": {
  "_doc": "Valor sugerido para a thread de missoes: missao comum no nivel L da cerca de 40% do xp_para_proximo(L); missao de historia 70%.",
  "comum": "0.40 * xp_para_proximo(L)",
  "historia": "0.70 * xp_para_proximo(L)"
 },
