{
  "_doc": "Sensacao dos golpes (game feel). Tudo isso e so visual/sonoro no cliente: o servidor manda o evento de dano e o cliente toca o perfil. Tempos em ms, distancias em px na resolucao base 640x360 (dobrada para 1280x720). Ver combate.md secao 2.",
  "versao": "0.1",
  "animacao_de_ataque": {
    "_doc": "Todo ataque tem 3 fases. O dano sai no PRIMEIRO frame da fase ativa (frame de impacto), nunca no fim da animacao. fps da animacao escala com a velocidade de ataque.",
    "fps_base": 15,
    "fases_frames": {
      "preparo": 3,
      "ativo": 1,
      "recuperacao": 3
    },
    "buffer_de_comando_ms": 150,
    "cancelar_recuperacao_em": [
      "habilidade",
      "mobilidade",
      "pocao",
      "movimento_apos_ms:80"
    ],
    "virar_para_alvo_antes_do_golpe": true,
    "avanco_no_golpe_px": 4,
    "_avanco": "o sprite do atacante avanca 4px na direcao do golpe no frame de impacto e volta na recuperacao"
  },
  "controles": {
    "_doc": "Definido pelo Jefin (2026-10-04): anda com o mouse, ataque basico com o mouse, habilidades nas teclas numericas 1, 2, 3...",
    "clique_esquerdo_no_chao": "anda ate o ponto; segurar o botao faz o personagem seguir o mouse",
    "clique_esquerdo_em_inimigo": "anda ate o alcance e ataca em loop ate o alvo morrer ou o jogador clicar em outra coisa",
    "segurar_shift": "ataca no lugar, sem andar (util para Humano/Cultista)",
    "teclas_1_a_9": "usa a habilidade do slot na hora (sem selecionar antes): alvo = inimigo sob o mouse; se nao houver, o alvo atual; habilidades de area/mobilidade vao no ponto sob o mouse",
    "tecla_sem_alvo_valido": "se o alvo esta fora do alcance, anda ate o alcance e solta a habilidade (fica no buffer ate 2s)",
    "q_w_e": "pocoes (vida, recurso, antidoto)",
    "alvo_magnetico_px": 18,
    "_alvo_magnetico": "clique a ate 18px de um inimigo conta como clique nele; ajuda muito em isometrico"
  },
