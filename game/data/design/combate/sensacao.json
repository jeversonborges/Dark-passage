      "normal": 0.2,
      "bruto": 0.7,
      "elite": 0.8,
      "chefe": 1.0
    },
    "_resistencia": "empurrao_final = empurrao_px * (1 - resistencia). Chefe so recua quando a postura quebra."
  },
