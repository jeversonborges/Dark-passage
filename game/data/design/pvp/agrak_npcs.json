   "npc": "caim_abel",
   "inicio": "raiz",
   "nos": {
    "raiz": {
     "fala": "CAIM: Cem de ouro pra entrar na lista! ABEL: Ele ensaiou isso a semana toda. CAIM: E A SUA VIDA! ABEL: O ouro a gente devolve se não tiver luta. A vida, o Saulo.",
     "opcoes": [
      {
       "texto": "Quero entrar no Agrak (100 de ouro, nível 25).",
